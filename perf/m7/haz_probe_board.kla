// haz_probe_board.kla — GENERATED by gen_probe.py. Do not edit by hand.
// M7 hazard-attribution probe: per-kernel dump of 0xF00D_00B0..00E8 (+cyc,instr).
// Fields/line (16 hex each): id cyc instr DATA LOADUSE FLAGS SP MULDIV BRFLUSH IFMISS MEMWAIT
_start
SETR A 0x8000000
SETSP A

CALL clear_perf:
CALL k_alu:
SETR D 0
CALL dump:

CALL clear_perf:
CALL k_mem:
SETR D 1
CALL dump:

CALL build_perm:
CALL clear_perf:
CALL k_chase:
SETR D 2
CALL dump:

CALL clear_perf:
CALL k_branch:
SETR D 3
CALL dump:

CALL clear_perf:
CALL k_fib_top:
SETR D 4
CALL dump:

CALL clear_perf:
CALL k_muldiv:
SETR D 5
CALL dump:

HALT

// ---- putc: transmit low byte of A. clobbers B,C ----
putc:
SETR B 0xF0010010
putc_wait:
MEMGET32 C B
ANDV C 1
CMPRV C 0
JMPNE putc_wait:
SETR B 0xF0010000
MEMSET8 A B
RET

// ---- puthex16: print E as 16 hex digits (MSB first). clobbers A,B,C,F,H ----
puthex16:
SETR F 64
puthex16_loop:
MINUSV F 4
SHRR A E F
ANDV A 0xF
COPY H A
ADDV A 0x30
CMPRV H 10
JMPULT puthex16_skip:
ADDV A 7
puthex16_skip:
CALL putc:
CMPRV F 0
JMPNE puthex16_loop:
RET

// ---- crlf ----
crlf:
SETR A 0x0D
CALL putc:
SETR A 0x0A
CALL putc:
RET

// ---- clear_perf: PERF_CTRL bit0 self-clearing -> zero all perf counters ----
clear_perf:
SETR B 0xF00D0000
SETR A 1
MEMSET32 A B
RET

// ---- dump: D=kernel id.  CRITICAL: snapshot ALL counters into a DDR
//      scratch array BEFORE any UART, exactly like perf_baseline.c bench()
//      (printing busy-waits thousands of cycles per byte and each poll is
//      an MMIO load — printing inside the read window corrupts IF_MISS/
//      MEM_WAIT with the dump's own overhead).  Then print from scratch.
dump:
SETR I 0x80000
SETR G 0xF00D0008
MEMGET64 E G
MEMSET64 E I
ADDV I 8
SETR G 0xF00D0010
MEMGET64 E G
MEMSET64 E I
ADDV I 8
SETR G 0xF00D00B0
MEMGET64 E G
MEMSET64 E I
ADDV I 8
SETR G 0xF00D00B8
MEMGET64 E G
MEMSET64 E I
ADDV I 8
SETR G 0xF00D00C0
MEMGET64 E G
MEMSET64 E I
ADDV I 8
SETR G 0xF00D00C8
MEMGET64 E G
MEMSET64 E I
ADDV I 8
SETR G 0xF00D00D0
MEMGET64 E G
MEMSET64 E I
ADDV I 8
SETR G 0xF00D00D8
MEMGET64 E G
MEMSET64 E I
ADDV I 8
SETR G 0xF00D00E0
MEMGET64 E G
MEMSET64 E I
ADDV I 8
SETR G 0xF00D00E8
MEMGET64 E G
MEMSET64 E I
ADDV I 8
COPY E D
CALL puthex16:
SETR I 0x80000
SETR J 10
dump_print:
MEMGET64 E I
CALL puthex16:
ADDV I 8
MINUSV J 1
CMPRV J 0
JMPNE dump_print:
CALL crlf:
RET

// ---- k_alu: a+=b; a^=(a<<7); a-=(b>>3); b+=a; b^=(b<<11); b+=i ----
k_alu:
SETR64 A 0x0123456789ABCDEF
SETR64 B 0xFEDCBA9876543210
SETR C 0
SETR D 0x30D40
k_alu_loop:
ADDR A A B
COPY E A
SHLV E 7
XORR A A E
COPY E B
SHRV E 3
SUBR A A E
ADDR B B A
COPY E B
SHLV E 11
XORR B B E
ADDR B B C
INCR C
CMPRR C D
JMPULT k_alu_loop:
RET

// ---- k_mem: for r: (for i: b[i]=b[i]+i+r) ; (for i: sum+=b[i]) ----
k_mem:
SETR A 0x2000000
SETR B 0x8000
SETR C 0
SETR64 H 0
k_mem_rloop:
SETR D 0
COPY E A
k_mem_rw:
MEMGET64 F E
ADDR F F D
ADDR F F C
MEMSET64 F E
ADDV E 8
INCR D
CMPRR D B
JMPULT k_mem_rw:
SETR D 0
COPY E A
k_mem_r:
MEMGET64 F E
ADDR H H F
ADDV E 8
INCR D
CMPRR D B
JMPULT k_mem_r:
INCR C
CMPRV C 0x4
JMPULT k_mem_rloop:
RET

// ---- build_perm: b[i]=i then Sattolo shuffle (xorshift32 rng) ----
build_perm:
SETR A 0x2000000
SETR B 0x8000
SETR C 0
COPY E A
build_perm_init:
MEMSET64 C E
ADDV E 8
INCR C
CMPRR C B
JMPULT build_perm_init:
SETR G 0x2545F491
COPY C B
MINUSV C 1
build_perm_shuf:
CMPRV C 0
JMPE build_perm_done:
COPY H G
SHLV H 13
XORR G G H
ANDV G 0xFFFFFFFF
COPY H G
SHRV H 17
XORR G G H
ANDV G 0xFFFFFFFF
COPY H G
SHLV H 5
XORR G G H
ANDV G 0xFFFFFFFF
MODUR D G C
COPY E C
SHLV E 3
ADDR E E A
COPY F D
SHLV F 3
ADDR F F A
MEMGET64 H E
MEMGET64 I F
MEMSET64 I E
MEMSET64 H F
MINUSV C 1
JMP build_perm_shuf:
build_perm_done:
RET

// ---- k_chase: idx = b[idx]; acc += idx  (dependent-load chain) ----
k_chase:
SETR A 0x2000000
SETR C 0
SETR64 H 0
SETR D 0
SETR E 0x30D40
k_chase_loop:
COPY F C
SHLV F 3
ADDR F F A
MEMGET64 C F
ADDR H H C
INCR D
CMPRR D E
JMPULT k_chase_loop:
RET

// ---- k_branch: prng then ~50%/~25%/~6% taken branches ----
k_branch:
SETR A 0x1234567
SETR64 H 0
SETR D 0
SETR E 0x7A120
k_branch_loop:
COPY F A
SHLV F 13
XORR A A F
ANDV A 0xFFFFFFFF
COPY F A
SHRV F 17
XORR A A F
ANDV A 0xFFFFFFFF
COPY F A
SHLV F 5
XORR A A F
ANDV A 0xFFFFFFFF
COPY F A
ANDV F 0x80000000
CMPRV F 0
JMPE k_branch_b2:
ADDV H 1
k_branch_b2:
COPY F A
ANDV F 0xFF
CMPRV F 64
JMPUGE k_branch_b3:
ADDV H 2
k_branch_b3:
COPY F A
ANDV F 0xF00
CMPRV F 0
JMPNE k_branch_next:
ADDV H 3
k_branch_next:
INCR D
CMPRR D E
JMPULT k_branch_loop:
RET

// ---- fib(A) -> M  (naive recursion; exercises CALL/RET/stack) ----
fib:
CMPRV A 2
JMPUGE fib_rec:
COPY M A
RET
fib_rec:
PUSH A
MINUSV A 1
CALL fib:
POP A
PUSH M
MINUSV A 2
CALL fib:
POP A
ADDR M A M
RET

k_fib_top:
SETR A 0x1C
CALL fib:
RET

// ---- k_muldiv: a*=i; acc += a/(i|1); acc ^= a%(i|3) ----
k_muldiv:
SETR64 A 0x9E3779B97F4A7C15
SETR64 H 0
SETR C 1
SETR D 0xC350
k_muldiv_loop:
MULR A A C
COPY E C
ORV E 1
DIVUR F A E
ADDR H H F
COPY E C
ORV E 3
MODUR F A E
XORR H H F
INCR C
CMPRR C D
JMPULE k_muldiv_loop:
RET
