// print_hex64: D printed as 16 hex digits (destroys A,C,E)
print_hex64:
SETR E 16
ph_loop:
ROLV D 4
COPY A D
ANDV A 0xF
CMPRV A 10
JMPULT ph_digit:
ADDV A 55
JMP ph_out:
ph_digit:
ADDV A 48
ph_out:
CALL putc:
MINUSV E 1
JMPNZ ph_loop:
RET

putc:
